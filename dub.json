{
	"name": "libp2p",
	"description": "libp2p for D — fibers on vibe-core, crypto on libsodium",
	"authors": [
		"caetano"
	],
	"license": "MIT",
	"targetType": "library",
	"targetPath": "bin",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"vibe-core": "~>2.0",
		"libsodiumd": "~>0.2",
		"openssl": "~>3.4"
	},
	"configurations": [
		{
			"name": "library",
			"targetType": "library",
			"dependencies": {
				"webrtc": {
					"path": "../d-webrtc-v3"
				}
			}
		},
		{
			"name": "library-no-webrtc",
			"targetType": "library",
			"excludedSourceFiles": [
				"source/libp2p/transport/webrtc/*.d"
			]
		},
		{
			"name": "interop-peer",
			"targetType": "executable",
			"targetName": "interop-peer",
			"mainSourceFile": "interop/dpeer/app.d",
			"sourcePaths": [
				"source",
				"interop/dpeer"
			],
			"importPaths": [
				"source",
				"interop/dpeer"
			],
			"dependencies": {
				"webrtc": {
					"path": "../d-webrtc-v3"
				}
			}
		},
		{
			"name": "webrtc-stun-smoke",
			"targetType": "executable",
			"targetName": "webrtc-stun-smoke",
			"mainSourceFile": "interop/webrtc-stun/app.d",
			"sourcePaths": ["source", "interop/webrtc-stun"],
			"importPaths": ["source", "interop/webrtc-stun"],
			"dependencies": {
				"webrtc": {
					"path": "../d-webrtc-v3"
				}
			}
		},
		{
			"name": "ut",
			"targetType": "executable",
			"targetName": "libp2p-test",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"dependencies": {
				"unit-threaded": "~>2.2",
				"fluent-asserts": "~>2.0",
				"webrtc": {
					"path": "../d-webrtc-v3"
				}
			},
			"dflags": [
				"-unittest"
			]
		}
	],
	"libs": [
		"crypto",
		"cares",
		"ssl"
	]
}
