#!/bin/bash
# vpn — user-mode WireGuard VPN over the libp2p QUIC hole-punch (serverless).
#
# Data plane: userspace WireGuard (wireguard-go), run with NO root after a one-time
# `vpn setup` (setcap cap_net_admin+eip, via sudo or the docker group). The srflx
# gather, the simultaneous QUIC hole-punch and the WG<->stream tunnel are the
# user-mode `wg-punch` node. No relay, no public server in the data path.
#
# Serverless connect (both peers behind NAT):
#   peer1$ vpn connect --role listener        # prints a ticket, then asks for the peer's
#   peer2$ vpn connect --role dialer          # prints a ticket (with the fire time)
#   paste each side's ticket into the other; both punch at the shared instant.
set -u

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NODE="${VPN_NODE:-$HERE/bin/wg-punch}"
STATE="${VPN_STATE:-$HOME/.wgvpn}"; mkdir -p "$STATE"
BIN="${VPN_BIN:-$STATE/bin}"; mkdir -p "$BIN"
WGGO="$BIN/wireguard-go"            # userspace WireGuard (setcap'd by `vpn setup`)
AMB="$BIN/capsh"                    # setcap cap_net_admin+eip -> raises ambient for ip
WGTOOLS_IMG="${VPN_WGTOOLS:-wgtools}"
IFACE="${VPN_IFACE:-wgvpn}"
PROXY="${VPN_PROXY:-51821}"; WGP="${VPN_WGP:-51820}"

die(){ echo "vpn: $*" >&2; exit 1; }
# run a privileged (CAP_NET_ADMIN) command: as root, directly; as a user, via the
# setcap'd capsh which raises the ambient capability for the child (ip/link).
runcap(){ if [ "$(id -u)" = 0 ]; then bash -c "$*"; else "$AMB" --keep=1 --inh=cap_net_admin --addamb=cap_net_admin -- -c "$*"; fi; }
# portable ms (some `date` builds ignore %3N and emit full ns)
now_ms(){ local n; n=$(date +%s%N); echo $(( n / 1000000 )); }
# a shared fire instant: round now+grace up to the next 15s boundary, so two peers
# that discover each other within the same window agree without exchanging it.
fire_at(){ local ms=$(( $(now_ms) + $1*1000 + 29999 )); echo $(( (ms / 30000) * 30000 )); }

setcap_both(){  # one-time privilege: prefer sudo, else the docker group
  if sudo -n true 2>/dev/null; then
    sudo setcap cap_net_admin+eip "$WGGO" && sudo setcap cap_net_admin+eip "$AMB"
    sudo mkdir -p /run/wireguard && sudo chown "$(id -u):$(id -g)" /run/wireguard && sudo chmod 700 /run/wireguard
  elif docker info >/dev/null 2>&1; then
    docker run --rm --privileged -v "$BIN":/b "$WGTOOLS_IMG" sh -c \
      "setcap cap_net_admin+eip /b/wireguard-go && setcap cap_net_admin+eip /b/capsh" || return 1
    docker run --rm --privileged -v /run:/run "$WGTOOLS_IMG" bash -c \
      "mkdir -p /run/wireguard && chown $(id -u):$(id -g) /run/wireguard && chmod 700 /run/wireguard" || return 1
  else
    die "need sudo or the docker group for the one-time setcap"
  fi
}

cmd="${1:-}"; shift || true
case "$cmd" in

setup)
  # userspace WireGuard binary
  if [ ! -x "$WGGO" ]; then
    if command -v go >/dev/null; then
      t="$(mktemp -d)"; git clone --depth 1 https://git.zx2c4.com/wireguard-go "$t/wg" >/dev/null 2>&1 \
        || die "git clone wireguard-go failed"
      ( cd "$t/wg" && go build -o "$WGGO" . ) || die "go build wireguard-go failed"; rm -rf "$t"
    else
      die "no wireguard-go at $WGGO and no Go to build it — drop a linux-amd64 wireguard-go there"
    fi
  fi
  cp -f /usr/bin/capsh "$AMB" 2>/dev/null || die "capsh (libcap) not found"
  setcap_both || die "setcap failed"
  if [ ! -s "$STATE/wg.key" ]; then ( umask 077; wg genkey > "$STATE/wg.key" ); wg pubkey < "$STATE/wg.key" > "$STATE/wg.pub"; fi
  echo "vpn: setup ok"
  echo "  wireguard-go: $(getcap "$WGGO")"
  echo "  wg pubkey:    $(cat "$STATE/wg.pub")"
  ;;

pubkey) cat "$STATE/wg.pub" 2>/dev/null || die "no key (run: vpn setup)";;

connect)
  ROLE=""; WGIP=""; PEER_TICKET=""; GRACE=60; EMIT=""; PEER_FILE=""
  while [ $# -gt 0 ]; do case "$1" in
    --role) ROLE="$2"; shift 2;;
    --wg-ip) WGIP="$2"; shift 2;;               # our WG address (default .1 dialer / .2 listener)
    --peer-ticket) PEER_TICKET="$2"; shift 2;;  # non-interactive: the peer's ticket blob
    --peer-ticket-file) PEER_FILE="$2"; shift 2;; # headless: poll this file for the peer ticket
    --emit-ticket) EMIT="$2"; shift 2;;         # headless: write our ticket to this file
    --grace) GRACE="$2"; shift 2;;              # seconds until the shared fire instant (dialer)
    *) die "unknown arg $1";;
  esac; done
  [ "$ROLE" = dialer ] || [ "$ROLE" = listener ] || die "--role dialer|listener required"
  [ -x "$WGGO" ] || die "run: vpn setup"
  [ -s "$STATE/wg.key" ] || die "run: vpn setup"
  [ -n "$WGIP" ] || { [ "$ROLE" = dialer ] && WGIP=10.9.0.1 || WGIP=10.9.0.2; }

  rm -f "$STATE/our.ticket" "$STATE/peer.node"
  # start the node — it gathers our srflx, writes it, then waits for peer.node
  setsid "$NODE" --mode punch --role "$ROLE" --service udp \
    --proxy-port "$PROXY" --wg-port "$WGP" \
    --out-file "$STATE/our.ticket" --peer-file "$STATE/peer.node" --fire-at 0 \
    >"$STATE/node.log" 2>&1 &
  NODEPID=$!
  trap 'kill $NODEPID 2>/dev/null; pkill -f "wireguard-go -f $IFACE" 2>/dev/null; runcap "ip link del $IFACE 2>/dev/null" 2>/dev/null' EXIT
  for i in $(seq 1 40); do [ -s "$STATE/our.ticket" ] && break; sleep 0.5; done
  [ -s "$STATE/our.ticket" ] || die "node did not gather a reflexive address (STUN unreachable?)"
  OURS="$(head -1 "$STATE/our.ticket")"          # "<srflx> <peerId>"
  WGPUB="$(cat "$STATE/wg.pub")"

  if [ "$ROLE" = dialer ]; then FT=$(( $(now_ms) + GRACE*1000 )); TICKET="$OURS $WGPUB $WGIP $FT"
  else TICKET="$OURS $WGPUB $WGIP"; fi
  echo "==== YOUR TICKET (send to the peer) ===="
  echo "$TICKET"
  echo "======================================="
  [ -n "$EMIT" ] && printf '%s\n' "$TICKET" > "$EMIT"

  if [ -z "$PEER_TICKET" ] && [ -n "$PEER_FILE" ]; then
    echo "vpn: waiting for peer ticket at $PEER_FILE ..."
    for i in $(seq 1 600); do [ -s "$PEER_FILE" ] && { PEER_TICKET="$(head -1 "$PEER_FILE")"; break; }; sleep 0.5; done
  fi
  if [ -z "$PEER_TICKET" ]; then
    printf 'paste the peer ticket, then Enter:\n> '
    read -r PEER_TICKET
  fi
  # shellcheck disable=SC2086
  set -- $PEER_TICKET
  [ $# -ge 4 ] || die "bad peer ticket (need '<srflx> <peerId> <wgpub> <wgip> [fireMs]')"
  PSRFLX="$1"; PPEER="$2"; PPUB="$3"; PWGIP="$4"; PFT="${5:-}"
  [ "$ROLE" = dialer ] && SHARED_FT="$FT" || SHARED_FT="$PFT"
  [ -n "$SHARED_FT" ] || die "no fire instant (the dialer's ticket must carry it)"

  # bring up userspace WireGuard (no root)
  pkill -f "wireguard-go -f $IFACE" 2>/dev/null || true
  runcap "ip link del $IFACE 2>/dev/null" || true
  sleep 1
  WG_I_PREFER_BUGGY_USERSPACE_IMPLEMENTATION=1 setsid "$WGGO" -f "$IFACE" >"$STATE/wireguard-go.log" 2>&1 &
  sleep 2
  wg set "$IFACE" private-key "$STATE/wg.key" listen-port "$WGP" \
    peer "$PPUB" allowed-ips "$PWGIP/32" endpoint 127.0.0.1:"$PROXY" persistent-keepalive 15
  runcap "ip addr add $WGIP/24 dev $IFACE && ip link set up dev $IFACE"
  echo "vpn: userspace WireGuard up ($IFACE $WGIP) — peer $PWGIP over the punch; firing at $SHARED_FT"

  # hand the node the peer's libp2p srflx + the shared fire instant → it punches
  printf '%s %s %s\n' "$PSRFLX" "$PPEER" "$SHARED_FT" > "$STATE/peer.node"
  wait "$NODEPID"
  ;;

connect-dht)
  # Serverless discovery: derive keys from a shared secret, exchange only the srflx
  # over the hyperdht (no paste). Requires the vpn-rendezvous tool (d-hyperswarm).
  SECRET=""; GRACE=10
  while [ $# -gt 0 ]; do case "$1" in
    --secret) SECRET="$2"; shift 2;;
    --grace) GRACE="$2"; shift 2;;
    *) die "unknown arg $1";;
  esac; done
  [ -n "$SECRET" ] || die "--secret required"
  [ -x "$WGGO" ] || die "run: vpn setup"
  RZ="${VPN_RENDEZVOUS:-$HOME/lab/d-hyperswarm/bin/vpn-rendezvous}"
  [ -x "$RZ" ] || die "vpn-rendezvous not found at $RZ (build it in d-hyperswarm)"
  derive_wg(){ printf '%s' "$1" | openssl dgst -sha256 -binary | base64; }
  DPRIV="$(derive_wg "wg-dialer:$SECRET")";   DPUB="$(printf '%s' "$DPRIV" | wg pubkey)"
  LPRIV="$(derive_wg "wg-listener:$SECRET")"; LPUB="$(printf '%s' "$LPRIV" | wg pubkey)"

  rm -f "$STATE/our.ticket" "$STATE/peer.node"
  setsid "$NODE" --mode punch --role dialer --service udp \
    --proxy-port "$PROXY" --wg-port "$WGP" \
    --out-file "$STATE/our.ticket" --peer-file "$STATE/peer.node" --fire-at 0 \
    >"$STATE/node.log" 2>&1 &
  NODEPID=$!
  trap 'kill $NODEPID 2>/dev/null; pkill -f "wireguard-go -f $IFACE" 2>/dev/null; runcap "ip link del $IFACE 2>/dev/null" 2>/dev/null' EXIT
  for i in $(seq 1 40); do [ -s "$STATE/our.ticket" ] && break; sleep 0.5; done
  [ -s "$STATE/our.ticket" ] || die "node did not gather a reflexive address"
  # our srflx: /ip4/<ip>/udp/<port>/quic-v1
  SRFLX="$(head -1 "$STATE/our.ticket" | awk '{print $1}')"
  SIP="$(echo "$SRFLX" | sed -E 's#/ip4/([^/]+)/udp/([0-9]+)/.*#\1#')"
  SPORT="$(echo "$SRFLX" | sed -E 's#/ip4/([^/]+)/udp/([0-9]+)/.*#\2#')"
  echo "vpn: srflx $SIP:$SPORT — discovering peer over the DHT..."
  RES="$("$RZ" --secret "$SECRET" --srflx-ip "$SIP" --srflx-port "$SPORT" | grep '^PEER ')"
  [ -n "$RES" ] || die "no peer found over the DHT under this secret"
  # PEER <ip> <port> ROLE <dialer|listener>
  set -- $RES; PIP="$2"; PPORT="$3"; ROLE="$5"
  echo "vpn: peer $PIP:$PPORT, my role=$ROLE"

  if [ "$ROLE" = dialer ]; then MYPRIV="$DPRIV"; PPUB="$LPUB"; WGIP=10.9.0.1; PWGIP=10.9.0.2
  else MYPRIV="$LPRIV"; PPUB="$DPUB"; WGIP=10.9.0.2; PWGIP=10.9.0.1; fi
  ( umask 077; printf '%s\n' "$MYPRIV" > "$STATE/wg.key" )

  pkill -f "wireguard-go -f $IFACE" 2>/dev/null || true
  runcap "ip link del $IFACE 2>/dev/null" || true; sleep 1
  WG_I_PREFER_BUGGY_USERSPACE_IMPLEMENTATION=1 setsid "$WGGO" -f "$IFACE" >"$STATE/wireguard-go.log" 2>&1 &
  sleep 2
  wg set "$IFACE" private-key "$STATE/wg.key" listen-port "$WGP" \
    peer "$PPUB" allowed-ips "$PWGIP/32" endpoint 127.0.0.1:"$PROXY" persistent-keepalive 15
  runcap "ip addr add $WGIP/24 dev $IFACE && ip link set up dev $IFACE"
  FT=$(fire_at "$GRACE")
  echo "vpn: WireGuard up ($IFACE $WGIP) — peer $PWGIP; punching (role $ROLE) at $FT"
  printf '/ip4/%s/udp/%s/quic-v1 any %s %s\n' "$PIP" "$PPORT" "$FT" "$ROLE" > "$STATE/peer.node"
  wait "$NODEPID"
  ;;

down)
  pkill -f "wireguard-go -f $IFACE" 2>/dev/null || true
  pkill -x "$(basename "$NODE")" 2>/dev/null || true
  runcap "ip link del $IFACE 2>/dev/null" 2>/dev/null || true
  echo "vpn: down"
  ;;

*) cat >&2 <<USAGE
usage:
  vpn setup                      one-time: build/setcap userspace WireGuard, gen key
  vpn pubkey                     print this host's WireGuard public key
  vpn connect --role dialer|listener [--wg-ip A] [--grace S] [--peer-ticket "..."]
  vpn down
USAGE
  exit 1;;
esac
